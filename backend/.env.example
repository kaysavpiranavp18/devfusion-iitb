# Backend Server Configuration
PORT=3001

# Supabase Credentials (from your Supabase Dashboard -> Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
# Note: Use the service_role secret key for backend authentication/authorization overrides
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Client App URLs for redirects & cross-origin allowance
CLIENT_URL=http://localhost:5173
INVITE_BASE_URL=http://localhost:5173

# Resend API Credentials for sending emails (obtain from resend.com)
RESEND_API_KEY=re_your_api_key_here
MAIL_FROM="DevCollab <onboarding@resend.dev>"

# Gemini AI API Credentials (obtain from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

