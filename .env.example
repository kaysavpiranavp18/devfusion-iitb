# Supabase Credentials (for frontend client connection)
VITE_SUPABASE_URL=https://your_supabase_project_url.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Backend API Endpoint URL
# Leave unset in local development to default to http://localhost:3001/api,
# or set to your live production URL (e.g. https://your-backend.onrender.com/api)
VITE_API_URL=http://localhost:3001/api
